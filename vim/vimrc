" Minimal Vim configuration; independent of Neovim.
set nocompatible
syntax on
filetype plugin indent on
set number
set relativenumber
set showmode
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set backspace=indent,eol,start
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=5
set splitright
set splitbelow
let mapleader = " "
nnoremap <leader>w :write<CR>
nnoremap <leader>q :quit<CR>
nnoremap <Esc> :nohlsearch<CR>

